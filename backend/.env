APP_NAME=Biosecurity Federated Statistics Backend
APP_ENV=dev
APP_DEBUG=true

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=biosecurity_stat

JWT_SECRET_KEY=biosecurity-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# FISCO BCOS 上链服务
FISCO_ANCHOR_SERVICE_URL=http://123.60.109.244:18080
FISCO_ANCHOR_API_KEY=bio-anchor-2026-test
FISCO_ANCHOR_TIMEOUT_SECONDS=10
FISCO_CHAIN_TYPE=fisco_bcos
FISCO_CONTRACT_ADDRESS=0x6849f21d1e455e9f0712b1e99fa4fcd23758e8f1

# SecretFlow 联合统计服务
SECRETFLOW_STAT_SERVICE_URL=http://123.60.109.244:18180
SECRETFLOW_STAT_API_KEY=bio-secretflow-2026-test
SECRETFLOW_STAT_TIMEOUT_SECONDS=300
SECRETFLOW_ALICE_CSV=/data/alice_hospital_flu_202604.csv
SECRETFLOW_BOB_CSV=/data/bob_hospital_flu_202604.csv
SECRETFLOW_DEFAULT_START_DATE=2026-04-01
SECRETFLOW_DEFAULT_END_DATE=2026-04-30
SECRETFLOW_DEFAULT_SYNDROME_TYPE=ILI

# SecretFlow 联邦学习训练服务
SECRETFLOW_FL_SERVICE_URL=http://123.60.109.244:18181
SECRETFLOW_FL_API_KEY=bio-secretflow-fl-2026-test
SECRETFLOW_FL_TIMEOUT_SECONDS=900
SECRETFLOW_FL_ALICE_CSV=/data/alice_flu_fl_train.csv
SECRETFLOW_FL_BOB_CSV=/data/bob_flu_fl_train.csv
SECRETFLOW_FL_EPOCHS=5
SECRETFLOW_FL_BATCH_SIZE=32
SECRETFLOW_FL_LEARNING_RATE=0.001
